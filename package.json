{
  "name": "imagepme-desktop-poc",
  "version": "0.0.1",
  "description": "POC Electron — valide la capture passive du jeton node9 (secHASH) dans une webview ImagePME, sans stocker aucun identifiant.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.labelcopilotes.connecteur-imagepme",
    "productName": "Connecteur ImagePME",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*"
    ],
    "protocols": [
      {
        "name": "Copilotage ImagePME",
        "schemes": [
          "copilotage-imagepme"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://simulateur-eco.label-co-pilotes.com/connecteur-imagepme/"
      }
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
